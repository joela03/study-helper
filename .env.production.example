# Production environment. Copy to .env.production, fill in, and keep it out
# of git (.gitignore already covers *.env).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Your domain -------------------------------------------------------------
# Must already resolve to this host, with ports 80 and 443 reachable, or
# Caddy can't obtain a TLS certificate.
PUBLIC_DOMAIN=study.example.com
PUBLIC_ORIGIN=https://study.example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=studyhelper
POSTGRES_DB=studyhelper
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Auth --------------------------------------------------------------------
# Signs every access token. The app refuses to start in production without
# a real value; anyone holding it can mint a token for any account.
# Generate: openssl rand -hex 32
SECRET_KEY=

# Sign-ups need an invite code from an admin. Set false to open registration.
REQUIRE_INVITE=true

# --- LLM providers -----------------------------------------------------------
# At least one is needed for generation. Groq has a free tier.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
