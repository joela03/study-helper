# Database
POSTGRES_USER=studyhelper
POSTGRES_PASSWORD=studyhelper
POSTGRES_DB=studyhelper

# LLM APIs (at least one required for generation features)
# Groq - Free tier, recommended: https://console.groq.com
GROQ_API_KEY=

# OpenAI - Paid: https://platform.openai.com
OPENAI_API_KEY=

# Anthropic - Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which provider actually gets used. Leave blank to use whichever key is
# set; name one explicitly when more than one key is present.
#   groq | anthropic | openai
LLM_PROVIDER=

# Only used when LLM_PROVIDER=anthropic.
#   claude-sonnet-5  (~25p per lecture)
#   claude-haiku-4-5 (~13p, cheaper and weaker)
#   claude-opus-5    (~63p, most capable)
ANTHROPIC_MODEL=claude-sonnet-5
